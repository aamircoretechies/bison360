# Bison360 API Environment Variables Template
# Copy this file to .env.local and update the values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database URLs
DATABASE_URL="postgresql://username:password@localhost:5432/bison360_dev"
DIRECT_URL="postgresql://username:password@localhost:5432/bison360_dev"

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-a-strong-random-string"

# JWT Configuration
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# =============================================================================
# API CONFIGURATION
# =============================================================================
# API Base URLs
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL_STAGING="https://staging-api.bison360.com"
NEXT_PUBLIC_API_URL_PROD="https://api.bison360.com"

# Base Path (for deployment)
NEXT_PUBLIC_BASE_PATH=""

# API Feature Flags
NEXT_PUBLIC_ENABLE_API_CACHING="true"
NEXT_PUBLIC_ENABLE_API_RETRY="true"
NEXT_PUBLIC_ENABLE_API_LOGGING="true"
NEXT_PUBLIC_ENABLE_API_METRICS="true"

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Email Templates
SMTP_SENDER="Bison360"
SMTP_FROM="no-reply@bison360.com"

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
# Storage Type: 'local', 'aws-s3', 'digitalocean', 'cloudinary'
STORAGE_TYPE="local"

# AWS S3 Configuration
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="your-bucket-name"
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_FORCE_PATH_STYLE="true"
STORAGE_CDN_URL="https://your-cdn-url.com"

# =============================================================================
# EXTERNAL SERVICES CONFIGURATION
# =============================================================================
# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-secret"

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Payment Processing (Stripe)
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# Payment Processing (Square)
SQUARE_APPLICATION_ID="your-square-application-id"
SQUARE_ACCESS_TOKEN="your-square-access-token"
SQUARE_ENVIRONMENT="sandbox" # or "production"

# =============================================================================
# INTEGRATION CONFIGURATION
# =============================================================================
# GrownBy Integration
GROWNBY_API_KEY="your-grownby-api-key"
GROWNBY_WEBHOOK_SECRET="your-grownby-webhook-secret"

# Shipping Services
SHIPPING_EASY_API_KEY="your-shipping-easy-api-key"
SHIPPING_EASY_API_SECRET="your-shipping-easy-api-secret"

UPS_API_KEY="your-ups-api-key"
UPS_USERNAME="your-ups-username"
UPS_PASSWORD="your-ups-password"

FEDEX_API_KEY="your-fedex-api-key"
FEDEX_SECRET_KEY="your-fedex-secret-key"

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Sentry (Error Tracking)
SENTRY_DSN="your-sentry-dsn"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"

# LogRocket (Session Replay)
LOGROCKET_APP_ID="your-logrocket-app-id"

# DataDog (APM)
DATADOG_API_KEY="your-datadog-api-key"
DATADOG_APPLICATION_KEY="your-datadog-application-key"

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Redis Configuration (for caching and sessions)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000" # 15 minutes

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,https://bison360.com"

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Environment
NODE_ENV="development"

# Debug Mode
DEBUG="false"
VERBOSE_LOGGING="true"

# Hot Reload
FAST_REFRESH="true"

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# App Information
NEXT_PUBLIC_APP_NAME="Bison360"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_DESCRIPTION="Livestock and Meat Processing Management System"

# Company Information
COMPANY_NAME="Bison360"
COMPANY_EMAIL="info@bison360.com"
COMPANY_PHONE="+1-555-0123"
COMPANY_ADDRESS="123 Ranch Road, Cattle City, CC 12345"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/Disable Features
ENABLE_USER_REGISTRATION="true"
ENABLE_EMAIL_VERIFICATION="true"
ENABLE_TWO_FACTOR_AUTH="false"
ENABLE_API_DOCUMENTATION="true"
ENABLE_ANALYTICS="false"
ENABLE_MAINTENANCE_MODE="false"

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Database Backup
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS="30"
BACKUP_S3_BUCKET="your-backup-bucket"

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Push Notifications (Firebase)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# SMS Notifications (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# =============================================================================
# COMPLIANCE CONFIGURATION
# =============================================================================
# USDA Compliance
USDA_API_KEY="your-usda-api-key"
USDA_ENDPOINT="https://api.usda.gov"

# Data Retention
DATA_RETENTION_DAYS="2555" # 7 years
AUDIT_LOG_RETENTION_DAYS="365" # 1 year

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Image Optimization
NEXT_PUBLIC_IMAGE_DOMAINS="localhost,bison360.com"
IMAGE_QUALITY="80"
IMAGE_FORMATS="webp,avif"

# CDN Configuration
CDN_URL="https://cdn.bison360.com"
CDN_CACHE_TTL="31536000" # 1 year

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test Database
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/bison360_test"

# Test Email
TEST_EMAIL="test@bison360.com"

# Mock Services
MOCK_EXTERNAL_SERVICES="false"
MOCK_PAYMENT_PROCESSING="false"

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Build Configuration
NEXT_PUBLIC_BUILD_ID="local"
NEXT_PUBLIC_BUILD_TIME=""

# Health Check
HEALTH_CHECK_ENDPOINT="/api/system/health"
HEALTH_CHECK_TIMEOUT="5000"

# Graceful Shutdown
GRACEFUL_SHUTDOWN_TIMEOUT="10000"
